--- !u!114 &5736707625751775326
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5745492943260761860}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 876b2e7922f1df6499f125ae93788a0e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _animator: {fileID: 0}
  _titleText: {fileID: 4592181724694618835}
  _destriptionText: {fileID: 259204650401665433}
  _info:
  - Name: 0
    ID: 0
    Title: Base Features
    Description: "For each facial feature on your character, there should be one
      <b><color=#BF3500>Base Feature</color></b>. For example, a character with one
      mouth, should have one base layer in the <b><color=#BF3500>mouth</color></b>
      category  \n\nDuring certain expressions, every base feature is replaced with
      an <b><color=#BF3500>alternate image</color></b> (like a closed eyelid for
      blinking) and all detail features are hidden. For example, a face with three
      base layers in the eyes category will have three sets of closed eyes when blinking"
  - Name: 1
    ID: 1
    Title: Details
    Description: "<b><color=#BF3500>Details</color></b> are extra images that are
      part of a feature, like eyelashes for eyes, or a piercing for eyebrows. For
      each distinct facial feature, there should be <b><color=#BF3500>one</color></b>
      base feature.\n\nFor example, to have two eyes, add one mirrored 'eye' feature
      to the base category, then add as many details as you want. For four eyes,
      duplicate the mirrored base feature, then add more details as desired. \n\n<i>Two
      eyes can also be created with one left mirror eye and one right mirror eye
      for asymetrical designs."
