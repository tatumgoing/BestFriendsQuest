  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b><color=#BF3500>Details</color></b> are extra images that are part of
    a feature, like eyelashes for eyes, or a piercing for eyebrows. For each distinct
    facial feature, there should be <b><color=#BF3500>one</color></b> base feature.\n\nFor
    example, to have two eyes, add one mirrored 'eye' feature to the base category,
    then add as many details as you want. For four eyes, duplicate the mirrored base
    feature, then add more details as desired. \n\n<i>Two eyes can also be created
    with one left mirror eye and one right mirror eye for asymetrical designs."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8c1d22a4556e6bf4b9d59df255fe692c, type: 2}
