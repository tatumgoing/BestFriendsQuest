--- !u!114 &1977744348
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1977744343}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 876b2e7922f1df6499f125ae93788a0e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _animator: {fileID: 0}
  _titleText: {fileID: 1571467160}
  _destriptionText: {fileID: 630646663}
  _info:
  - Name: 0
    ID: 0
    Title: Add-Ons
    Description: '<b><color=#BF3500>Add-Ons</color></b> are hair pieces that can
      be freely moved around the head of your character by <b><color=#BF3500>Left
      Clicking</color></b> on the piece and dragging with your mouse


      While
      editing Add-Ons, use <b><color=#BF3500>right click</color></b> to rotate the
      camera around your character.'
  - Name: 1
    ID: 1
    Title: Details
    Description: "<b><color=#BF3500>Details</color></b> are extra images that are
      part of a feature, like eyelashes for eyes, or a piercing for eyebrows. For
      each distinct facial feature, there should be <b><color=#BF3500>one</color></b>
      base feature.\n\nFor example, to have two eyes, add one mirrored 'eye' feature
      to the base category, then add as many details as you want. For four eyes,
      duplicate the mirrored base feature, then add more details as desired. \n\n<i>Two
      eyes can also be created with one left mirror eye and one right mirror eye
      for asymetrical designs."
